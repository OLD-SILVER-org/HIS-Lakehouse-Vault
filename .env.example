# ==========================================
# HOSPITAL DWH - GLOBAL ENVIRONMENT VARIABLES
# ==========================================
WEBHOOK_URL=your_webhook

# ==========================================
# 0. Onchestration GROUP )
AIRFLOW_IMAGE=apache/airflow:3.0.2

# ==========================================

# ==========================================
# 1. SOURCE GROUP (infrastructure/1_source)
# ==========================================
# Services: Postgres (Source), Kafka, Debezium

# --- PostgreSQL (Source DB) ---
SOURCE_POSTGRES_IMAGE=postgres:17
SOURCE_POSTGRES_PORT=5433
SOURCE_POSTGRES_USER=your_user
SOURCE_POSTGRES_PASSWORD=your_pass
SOURCE_POSTGRES_DB=postgres
# --- 

# --- CDC ---
CDC_SCHEMA=pgsql_source
CDC_DB=hospital_source
CDC_USER=your_user
CDC_PASSWORD=your_pass
CDC_PUBLICATION=hospital_pub

# --- Kafka (Kraft Mode) ---
SOURCE_KAFKA_IMAGE=apache/kafka:3.7.0
SOURCE_KAFKA_PORT_EXT=9092
SOURCE_KAFKA_PORT_CONTROLLER=9093
SOURCE_KAFKA_PORT_INT=9094
SOURCE_KAFKA_UI_PORT=8090

# --- Debezium (CDC) ---
SOURCE_DEBEZIUM_IMAGE=quay.io/debezium/connect:2.5
SOURCE_DEBEZIUM_PORT=8083



# ==========================================
# 2. LAKE GROUP (infrastructure/2_lake)
# ==========================================
# Services: MinIO, Hive Metastore, Flink

# --- MinIO (S3 Storage) ---
LAKE_MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
LAKE_MINIO_PORT_API=9000
LAKE_MINIO_PORT_CONSOLE=9001

LAKE_MINIO_ROOT_USER=your_user
LAKE_MINIO_ROOT_PASSWORD=your_pass
LAKE_MINIO_ENDPOINT=http://minio:9000
LAKE_HIVE_WAREHOUSE_DIR=s3a://hospital-datalake/
MINIO_CHECKPOINT_BUCKET=spark-checkpoint

# --- Hive Metastore ---
LAKE_HIVE_METASTORE_IMAGE=apache/hive:3.1.3
#LAKE_HIVE_METASTORE_IMAGE=apache/hive:standalone-metastore-4.2.0

LAKE_HIVE_METASTORE_PORT=9083
HIVE_METASTORE_URIS=thrift://hive-metastore:9083

# --- metastore (PostgreSQL DB) ---
LAKE_POSTGRES_IMAGE=postgres:17
LAKE_POSTGRES_PORT=5434
LAKE_POSTGRES_USER=your_user
LAKE_POSTGRES_PASSWORD=your_pass
LAKE_POSTGRES_DB=hive_metastore

# --- Flink ---
LAKE_FLINK_IMAGE=flink:1.18.1-scala_2.12-java17
LAKE_FLINK_JOBMANAGER_PORT=8087
LAKE_FLINK_TASKMANAGER_PORT=8082
LAKE_FLINK_AWS_REGION=us-east-1
# ==========================================



# ==========================================
# 3. WAREHOUSE GROUP (infrastructure/3_warehouse)
# ==========================================
# Services: Spark, DBT

# --- Spark ---
# SPARK_ENV=docker
SPARK_ENV=local

WAREHOUSE_SPARK_IMAGE=apache/spark:3.5.6-scala2.12-java17-ubuntu
WAREHOUSE_SPARK_MASTER_PORT=7077
WAREHOUSE_SPARK_WEBUI_PORT=8085
WAREHOUSE_SPARK_WORKER_PORT=8086

# --- warehouse (PostgreSQL DB) ---
WAREHOUSE_POSTGRES_IMAGE=postgres:17
WAREHOUSE_POSTGRES_PORT=5435
WAREHOUSE_POSTGRES_USER=your_user
WAREHOUSE_POSTGRES_PASSWORD=your_pass
WAREHOUSE_POSTGRES_DB=dwh


# --- Python / DBT ---
# Sửa lại trong file .env
WAREHOUSE_DBT_IMAGE=ghcr.io/dbt-labs/dbt-postgres:1.9.0

# ==========================================
# 4. BI GROUP (infrastructure/4_bi)
# ==========================================
# Services: Superset

# --- Superset ---
BI_SUPERSET_IMAGE=apache/superset:5.0.0
BI_SUPERSET_PORT=8088
BI_SUPERSET_USER=superset
BI_SUPERSET_PASS=superset@123

# --- Airflow ---
AIRFLOW_IMAGE_NAME=apache/airflow:3.2.1
AIRFLOW_PORT=8888
AIRFLOW_UID=50000

AIRFLOW_PROJ_DIR=.
AIRFLOW__CORE__TEST_CONNECTION=Enabled
FERNET_KEY=your_key

# Tài khoản đăng nhập giao diện web Airflow (mặc định: airflow/airflow)
_AIRFLOW_WWW_USER_USERNAME=your_user
_AIRFLOW_WWW_USER_PASSWORD=your_pass

_PIP_ADDITIONAL_REQUIREMENTS=apache-airflow-providers-apache-flink docker
AIRFLOW__API_AUTH__JWT_SECRET=your_jwt
FERNET_KEY=your_key
AIRFLOW__API_AUTH__JWT_ISSUER=thanhtinhshr

AIRFLOW_POSTGRES_IMAGE=postgres:17
AIRFLOW_POSTGRES_USER=your_user
AIRFLOW_POSTGRES_PASSWORD=your_pass
AIRFLOW_POSTGRES_DB=airflow


# ==========================================
# 5. NETWORK GROUP (services/network)
# ==========================================
NETWORK_DOMAIN=your_domain
NETWORK_EMAIL=your_email

NETWORK_WGDASHBOARD_IMAGE=donaldzou/wgdashboard:v4.3.3
NETWORK_WGDASHBOARD_PORT=10086
NETWORK_WGDASHBOARD_WG_PORT=51820
NETWORK_WGDASHBOARD_TZ=Asia/Ho_Chi_Minh
NETWORK_WGDASHBOARD_DNS=9.9.9.9

NETWORK_CADDY_IMAGE=caddy:2

# ELASTIC SEARCH - SPARK

ELASTIC_IMAGE=elasticsearch:8.17.2
ES_PASSWORD=thanhtinh@Pass123

ES_SPARK_IMAGE=apache/spark:3.5.6-scala2.12-java17-ubuntu
ES_SPARK_MASTER_PORT=7078
ES_SPARK_WEBUI_PORT=8089
ES_SPARK_WORKER_PORT=8084