# ==========================================
# HOSPITAL DWH - GOLDEN STACK VERSIONS (EXAMPLE)
# ==========================================
# Copy this file to .env and adjust if necessary

# --- Database & Streaming ---
POSTGRES_IMAGE=bitnami/postgresql:16.1.0-debian-11-r13
KAFKA_IMAGE=bitnami/kafka:3.6.1-debian-11-r0
DEBEZIUM_IMAGE=quay.io/debezium/connect:2.5.0.Final
FLINK_IMAGE=flink:1.18.1-java11

# --- Data Lake & Storage ---
MINIO_IMAGE=minio/minio:RELEASE.2024-01-31T20-20-33Z
HIVE_METASTORE_IMAGE=apache/hive:3.1.3

# --- Warehouse & Processing ---
SPARK_IMAGE=bitnami/spark:3.5.0-debian-11-r4
PYTHON_IMAGE=python:3.10.13-bookworm

# --- Business Intelligence ---
SUPERSET_IMAGE=apache/superset:3.1.0

# ==========================================
# COMMON CONFIGURATION
# ==========================================
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password
